<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">
<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_margin="10dp">

        <ImageView
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_ixi_logo"></ImageView>

        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:textSize="20sp"
            android:textStyle="bold"
            android:text="Administrativo" />

        <Button
            android:id="@+id/button_validarReferidores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            style="@style/BotonEstilo"
            android:text="Validar Referidores" />

        <Button
            android:id="@+id/button_validarConductores"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/BotonEstilo"
            android:text="Validar Conductores" />

        <Button
            android:id="@+id/button_validarVehiculos"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/BotonEstilo"
            android:text="Validar Vehiculos" />


        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/red_claro"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="10dp"
            android:layout_marginLeft="10dp" />

        <Button
            android:id="@+id/button_configuraciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/BotonEstilo"
            android:text="Configuraciones" />


    </LinearLayout>

</ScrollView>


</LinearLayout>